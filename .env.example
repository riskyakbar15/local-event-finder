# Example environment variables for Firebase configuration
# Replace values with your Firebase project's credentials

FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id

# Google OAuth client IDs (create them in Google Cloud Console).
# These must be prefixed with EXPO_PUBLIC_ so Expo exposes them to the client.
# They are not secrets. Provide at least one; add platform IDs as needed.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com

# For Expo, you can also put these under expo.extra in app.json/app.config.js
# or use EAS secrets for production.
