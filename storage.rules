rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Event images live under events/{uid}/... and may only be written
    // by the authenticated owner. Reads are public so anyone can view event
    // images. Uploads are limited to images up to 5 MB.
    match /events/{uid}/{allPaths=**} {
      allow read: if true;

      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
